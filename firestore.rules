rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function sessionPath(sessionId) {
      return /databases/$(database)/documents/auction_sessions/$(sessionId);
    }

    function sessionExists(sessionId) {
      return exists(sessionPath(sessionId));
    }

    function isSessionMember(sessionId) {
      return signedIn() &&
        sessionExists(sessionId) &&
        get(sessionPath(sessionId)).data.member_uids is list &&
        request.auth.uid in get(sessionPath(sessionId)).data.member_uids;
    }

    function isSessionOwner(sessionId) {
      return signedIn() &&
        sessionExists(sessionId) &&
        get(sessionPath(sessionId)).data.owner_uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if isSelf(uid);
      allow create, update: if isSelf(uid) &&
        request.resource.data.uid == request.auth.uid;
      allow delete: if isSelf(uid);
    }

    // Ponte temporaneo per il solo ripristino delle sessioni schema <= 5.
    match /players/{playerId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /auction_sessions/{sessionId} {
      allow create: if signedIn() &&
        request.resource.data.owner_uid == request.auth.uid &&
        request.resource.data.member_uids is list &&
        request.auth.uid in request.resource.data.member_uids;

      // Le query Firestore devono poter dimostrare l'accesso dai propri
      // filtri. Le query del proprietario usano owner_uid, mentre quelle
      // collaborative possono usare member_uids array-contains.
      allow read: if signedIn() && (
        resource.data.owner_uid == request.auth.uid ||
        (
          resource.data.member_uids is list &&
          request.auth.uid in resource.data.member_uids
        )
      );

      allow update: if isSessionOwner(sessionId) &&
        request.resource.data.owner_uid == resource.data.owner_uid &&
        request.resource.data.member_uids is list &&
        resource.data.owner_uid in request.resource.data.member_uids;

      allow delete: if isSessionOwner(sessionId);

      match /players/{playerId} {
        allow read: if isSessionMember(sessionId);
        allow create, update: if isSessionOwner(sessionId);
        allow delete: if false;
      }

      // Stato effimero e minimale dell'asta. Il controller proprietario
      // aggiorna questo documento insieme all'evento autorevole.
      match /live/{liveDocument} {
        allow read: if isSessionMember(sessionId);
        allow create, update: if isSessionOwner(sessionId);
        allow delete: if false;
      }

      match /events/{eventId} {
        allow read: if isSessionMember(sessionId);
        allow create: if isSessionOwner(sessionId) &&
          request.resource.data.created_by_uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
